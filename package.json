{
  "name": "@nxlabs/agent-memory",
  "version": "0.1.0",
  "description": "Long-term memory for agents on Postgres + pgvector: facts as a temporal graph with provenance, hybrid recall, notes and a document index. Bun, TypeScript source.",
  "type": "module",
  "license": "Apache-2.0",
  "repository": "github:nxlabscc/agent-memory",
  "exports": {
    ".": "./src/index.ts"
  },
