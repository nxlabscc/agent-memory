    "src/migrations/*.sql",
    "!src/**/*.test.ts"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test src test/doubles",
    "test:integration": "bun test test/integration"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "typescript": "^5.6.0",
    "postgres": "^3.4.5"
  }
}
